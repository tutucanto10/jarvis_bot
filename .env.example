TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=     # string aleatória (A-Z a-z 0-9 _ -), validada no header X-Telegram-Bot-Api-Secret-Token
ALLOWED_CHAT_ID=             # meu chat_id; qualquer outro chat é ignorado em silêncio
DATABASE_URL=                # Neon, connection string do pooler (postgresql://...-pooler...?sslmode=require)
GEMINI_API_KEY=              # IA padrão (grátis): aistudio.google.com → Get API key
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=           # opcional: usa Claude se não houver GEMINI_API_KEY (ou com AI_PROVIDER=anthropic)
AI_PROVIDER=                 # opcional: gemini | anthropic
CRON_SECRET=                 # protege a rota do cron (openssl rand -hex 32)
TZ_USER=America/Sao_Paulo
WEATHER_LAT=-22.80           # Ilha do Governador, RJ
WEATHER_LON=-43.20
WEATHER_LABEL=Ilha do Governador   # nome exibido no clima
FAVORITE_TEAMS=Flamengo      # sempre aparece primeiro e em destaque

# Só para os scripts locais (opcional): URL pública do deploy usada por `pnpm webhook:set`
APP_URL=
